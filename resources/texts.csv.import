[remap]

importer="csv_translation"
type="Translation"

[deps]

files=[ "res://resources/texts.en.translation", "res://resources/texts.hu.translation" ]

source_file="res://resources/texts.csv"
dest_files=[ "res://resources/texts.en.translation", "res://resources/texts.hu.translation" ]

[params]

compress=true
delimiter=0
